<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
	</configSections>
	<connectionStrings>
		<add name="MedicalStoreDB"
             connectionString="Server=.\SQLEXPRESS;Database=MedicalStoreDB;Integrated Security=True;TrustServerCertificate=True;"
             providerName="Microsoft.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<add key="LowStockThreshold" value="10" />
		<add key="ExpiryAlertDays" value="30" />
	</appSettings>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
	</startup>
</configuration>